rules_version = '2';

// Security model: this app has no accounts — anyone who is signed in
// (anonymously) AND knows a household's exact invite code has full access
// to that household's data, the same way "anyone with the link" works on a
// shared document. The `list: if false` line stops someone from browsing
// every household that exists; you can only reach one by its exact code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{householdId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update, delete: if request.auth != null;

      match /{subcollectionDocument=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
